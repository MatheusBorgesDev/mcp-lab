# Copie para .env.local (ignorado pelo git). Sem segredos aqui: só nomes e valores locais.

# Fase 1. Local: Supabase local (pnpm db:start). Produção: pooler do Supabase em modo transaction (porta 6543),
# configurado no painel da Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Fase 2: front (Vite). Públicas por design: a chave publicável só alcança o que o RLS libera para anon.
# Local: os dois valores de `pnpm exec supabase status` (API_URL e PUBLISHABLE_KEY). Produção: painel da Vercel,
# e só valem depois de um deploy novo (o Vite grava as VITE_* no build).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
