# Copie para .env.local (ignorado pelo git). Sem segredos aqui: só nomes e valores locais.

# Fase 1. Local: Supabase local (pnpm db:start). Produção: pooler do Supabase em modo transaction (porta 6543),
# configurado no painel da Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Fase 2: front (Vite). Públicas por design: a chave publicável só alcança o que o RLS libera para anon.
# Local: os dois valores de `pnpm exec supabase status` (API_URL e PUBLISHABLE_KEY). Produção: painel da Vercel,
# e só valem depois de um deploy novo (o Vite grava as VITE_* no build).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Fase 3: segredo do hash do IP do visitante (usado só pelos limites; o banco guarda o hash, nunca o IP).
# Local: qualquer texto com 16+ caracteres. Produção: painel da Vercel (Secret), gerado com `openssl rand -base64 32`.
IP_HASH_SALT=local-only-not-a-secret

# Fase 3: Redis do rate limit (criadas pela integração da Upstash na Vercel). Local: deixe vazias e o servidor
# conta as chamadas em memória. Na Vercel, sem elas o /mcp recusa rodar.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Fase 3: segredo do cron diário (a Vercel o manda como "Authorization: Bearer" ao chamar /api/cron/reset).
# Local: qualquer texto com 16+ caracteres. Produção: painel da Vercel (Sensitive), gerado com `openssl rand -base64 32`.
CRON_SECRET=local-only-cron-secret
