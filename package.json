{
  "name": "mcp-barber-shop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run --project unit --project web",
    "test:watch": "vitest --project unit --project web",
    "test:db": "vitest run --project db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "mcp-handler": "2.3.1",
    "postgres": "4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.93.0",
    "supabase": "3.1.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
